title: Labor Affairs
new-page: true
is-card: true
tags: govt_affairs, cabinet
on-arrival: labor_affairs_timer = 6; month_actions += 1;
view-if: spd_in_government = 1 and labor_minister_party = "SPD" and labor_affairs_timer = 0 and strike_term_seen = 0
card-image: img/portraits/WissellRudolf.jpg


= Labor Affairs

The industrial Ruhr region is aflame with labor unrest. The employers have started a major lockout to force the workers to take more cuts to wages and benefits. There is a need for the Labor Ministry to arbitrate in conflicts between employers and workers.

- @support_labor: Support labor in their demands.
- @support_employers: Support the employers in their demands.
- @balance: Try to strike a compromise between the sides.
- @easy_discard
- @cancel_advisor_action

@support_labor
subtitle: Popular among the workers, this will alienate the bourgeoisie.
on-arrival: {!

Q.labor_affairs_seen = 1;

if (Q.labor_minister_party == "KPD") {
    if (Q.spd_in_government) {
        Q.kpd_brandlerite_strength += 5;
        Q.kpd_conciliator_strength += 5;

        Q.kpd_weddinger_strength -= 5;
        
        Q.kpd_brandlerite_dissent -= 5;
        Q.kpd.kpd_conciliator_dissent -= 5;

        Q.kpd_weddinger_dissent += 5;

        Q.workers_kpd += 6*(1-Q.kpd_dissent);
    } else {
        Q.kpd_stalinist_strength += 5;

        Q.kpd_weddinger_strength -= 5;
        Q.kpd_brandlerite_strength -= 5;
        
        Q.kpd_stalinist_dissent -= 5;

        Q.kpd_weddinger_dissent += 5;
        Q.kpd_brandlerite_dissent += 5;

        Q.workers_kpd += 6*(1-Q.kpd_dissent);
    }
    Q.labor_strength += 5;

    Q.labor_dissent -= 5;
    Q.left_dissent -= 5;

    Q.workers_spd += 6*(1-Q.dissent);

    Q.ddp_kpd_relation -= 2;
    Q.z_kpd_relation -= 2;

    Q.labor_goal_completed += 1;
    Q.labor_goal_spd += 1;
    Q.goal_spd_cancel_peoples += 1;

    if ((Q.dvp_relation <= 30 && !Q.lvp_formed) || (Q.lvp_relation <= 30 && Q.lvp_formed)) {
        Q.capital_strike_progress += 1;
    }
} else if (Q.kpd_in_government) {
    Q.labor_strength += 3;

    Q.labor_dissent -= 3;
    Q.left_dissent -= 3;

    Q.workers_spd += 3*(1-Q.kpd_dissent);

    Q.dvp_relation -= 2;
    Q.ddp_relation -= 1;
    
    Q.labor_goal_completed += 1;
    Q.labor_goal_spd += 1;
}

if (Q.labor_minister_party == "SPD") {
    Q.labor_strength += 5;

    Q.labor_dissent -= 5;
    Q.left_dissent -= 5;

    Q.workers_spd += 6*(1-Q.dissent);

    Q.dvp_relation -= 4;
    Q.ddp_relation -= 2;

    Q.labor_goal_completed += 1;
    Q.labor_goal_spd += 1;
    Q.goal_spd_cancel_peoples += 1;

    if ((Q.dvp_relation <= 30 && !Q.lvp_formed) || (Q.lvp_relation <= 30 && Q.lvp_formed)) {
        Q.capital_strike_progress += 1;
    }
} else if (Q.spd_in_government) {
    Q.labor_strength += 3;

    Q.labor_dissent -= 3;
    Q.left_dissent -= 3;

    Q.workers_spd += 3*(1-Q.dissent);

    Q.dvp_relation -= 2;
    Q.ddp_relation -= 1;
    
    Q.labor_goal_spd += 1;
}

if (Q.labor_minister_party == Q.ddp_name) {
    Q.ddp_labor_strength += 4;

    Q.ddp_business_strength -= 4;

    Q.ddp_labor_dissent -= 4;

    Q.ddp_business_dissent += 4;

    Q.workers_ddp += 5*(1-Q.ddp_dissent);

    if ((Q.z_leader == "Wirth" && !(Q.dvp_in_government || Q.dnvp_in_government || Q.nsdap_in_government)) || (Q.z_leader == "Joos" && Q.spd_in_government && Q.peoples_party) || Q.z_leader == "Kaiser") {
        Q.ddp_z_relation -= 1;
    }
    
    Q.ddp_dvp_relation -= 2;
    

    if ((Q.ddp_dvp_relation <= 30 && !Q.lvp_formed)) {
        Q.capital_strike_progress += 1;
    }
} else if (Q.ddp_in_government && !Q.lvp_formed) {
    Q.ddp_labor_strength += 2;

    Q.ddp_business_strength -= 2;

    Q.ddp_labor_dissent -= 2;

    Q.ddp_business_dissent += 2;

    Q.workers_ddp += 3*(1-Q.ddp_dissent);

    Q.z_dvp_relation -= 1;
}

if (Q.labor_minister_party == "LVP") {
    Q.lvp_labor_strength += 3;

    Q.lvp_bourgeois_strength -= 3;

    Q.lvp_labor_dissent -= 3;

    Q.lvp_bourgeois_dissent += 3;
    Q.lvp_nationalist_dissent += 3;

    Q.workers_lvp += 4*(1-Q.lvp_dissent);

    if ((Q.z_leader == "Wirth" && !(Q.dvp_in_government || Q.dnvp_in_government || Q.nsdap_in_government)) || (Q.z_leader == "Joos" && Q.spd_in_government && Q.peoples_party) || Q.z_leader == "Kaiser") {
        Q.ddp_z_relation -= 1;
    }
} else if ((Q.ddp_in_government || Q.dvp_in_government) && Q.lvp_formed) {
    Q.lvp_labor_strength += 3;

    Q.lvp_business_strength -= 3;

    Q.lvp_labor_dissent -= 3;

    Q.lvp_bourgeois_dissent += 3;
    Q.lvp_nationalist_dissent += 3;

    Q.workers_lvp += 2*(1-Q.lvp_dissent);
}

if (Q.labor_minister_party == Q.z_party_name) {
    Q.z_left_strength += 3;

    Q.z_conservative_strength -= 3;

    Q.z_labor_dissent -= 3;
    Q.z_left_dissent -= 3;

    Q.z_conservative_dissent += 3;

    Q.workers_z += 5*(1-Q.z_dissent);

    Q.z_kpd_relation += 4;
    Q.z_dvp_relation -= 2;
    Q.ddp_z_relation -= 1;

    if ((Q.z_dvp_relation <= 30 && !Q.lvp_formed) || (Q.lvp_z_relation <= 30 && Q.lvp_formed)) {
        Q.capital_strike_progress += 1;
    }
} else if (Q.z_in_government) {
    Q.z_left_strength += 1;

    Q.z_conservative_strength -= 1;

    Q.z_labor_dissent -= 1;
    Q.z_left_dissent -= 1;

    Q.z_conservative_dissent += 1;

    Q.workers_z += 3*(1-z_dissent);

    Q.z_dvp_relation -= 1;
}

if (Q.dvp_in_government && !Q.lvp_formed) {
    Q.dvp_labor_strength += 2;

    Q.dvp_industrialist_strength -= 2;

    Q.dvp_labor_dissent -= 2;

    Q.dvp_industrialist_dissent += 2;
    Q.dvp_nationalist_dissent += 2;

    Q.workers_dvp += 1*(1-Q.dvp_dissent);
}

if (Q.kvp_in_government) {
    Q.kvp_christian_social_strength += 1;

    Q.kvp_volkskonservativ_strength -= 1;

    Q.kvp_christian_social_dissent -= 1;

    Q.kvp_volkskonservativ_dissent += 1;
    Q.kvp_nationalist_dissent += 1;

    Q.workers_kvp += 1*(1-Q.kvp_dissent);
}

if (Q.dnvp_in_government) {
    Q.dnvp_christian_social_strength += 1;

    Q.dnvp_authoritarian_strength -= 1;

    Q.dnvp_christian_social_dissent -= 1;

    Q.dnvp_volkskonservativ_dissent += 1
    Q.dnvp_agrarian_dissent += 1;
    Q.dnvp_authoritarian_dissent += 1;

    Q.workers_dnvp += 1*(1-Q.dnvp_dissent);
}

if (Q.dnf_in_government) {
    Q.dnf_paramilitary_strength += 2;

    Q.dnf_authoritarian_strength -= 2;

    Q.dnf_paramilitary_dissent -= 2;
    Q.dnf_volkisch_dissent -= 2;

    Q.dnf_authoritarian_dissent += 2;
    Q.dnf_nationalist_dissent += 2;
}

if ((Q.z_in_government && Q.labor_minister_party != Q.z_party_name) || Q.dvp_in_government || Q.dnvp_in_government || Q.bvp_in_government || Q.kvp_in_government || Q.ddp_in_government) {
    Q.coalition_dissent += 1;
}

if (Q.unemplyed > 15) {
    Q.capital_strike_progress += 1;
}

if (Q.unemplyed > 24) {
    Q.capital_strike_progress += 1;
}

Q.inflation += 0.1;
Q.pro_labor += 1;
Q.strike_term_seen += 1;
Q.dvp_right += 1;
Q.ddp_left += 1;
Q.ddp_cohesion -= 1;
Q.lvp_right += 1;
Q.economic_growth -= 0.1;
!}

Supporting labor is always popular in the <span style="color: #c00000;">**SPD**</span>, although many of our coalition partners represent employers, and they are less enthused.

@support_employers
subtitle: Popular among the bourgeoisie, much less so among the workers.
on-arrival: {!
    Q.labor_affairs_seen = 1;

    if (Q.kpd_in_government) {
        Q.kpd_weddinger_dissent += 8;
        Q.kpd_stalinist_dissent += 7;
        Q.kpd_conciliator_dissent += 6;
        Q.kpd_brandlerite_dissent += 5;

        Q.workers_kpd -= 2;

        kpd_coalition_dissent += 1;
    } else {
        Q.workers_kpd += 3;
    }

    if (Q.labor_minister_party == "SPD") {
        Q.labor_dissent += 8;

        Q.workers_spd -= 3;

        Q.kpd_relation -= 8;
        Q.dvp_relation += 5;
        Q.lvp_relation += 5;
        Q.z_relation += 5;
        Q.ddp_relation += 4;

        Q.goal_spd_cancel += 1;
        Q.labor_goal_spd_peoples += 1;
    } else if (Q.spd_in_government) {
        Q.labor_dissent += 4;

        Q.workers_spd -= 1;

        Q.kpd_relation -= 4;
        Q.dvp_relation += 3;
        Q.lvp_relation += 3;
        Q.z_relation += 3;
        Q.ddp_relation += 2;
    }

    
    if (Q.labor_minister_party == Q.ddp_name) {
        Q.ddp_business_strength += 2;

        Q.ddp_labor_strength -= 2;

        Q.ddp_business_dissent -= 2;
        
        Q.ddp_labor_dissent += 2;

        Q.workers_ddp -= 2;

        Q.ddp_kpd_relation -= 4;
        Q.ddp_z_relation += 3;
        Q.ddp_dvp_relation += 3;
        Q.ddp_dnvp_relation += 3;
    } else if (Q.ddp_in_government && !Q.lvp_formed) {
        Q.ddp_business_strength += 1;

        Q.ddp_labor_strength -= 1;

        Q.ddp_business_dissent -= 1;
        
        Q.ddp_labor_dissent += 1;

        Q.workers_ddp -= 1;

        Q.ddp_kpd_relation -= 2;
        Q.ddp_z_relation += 1;
        Q.ddp_dvp_relation += 1;
        Q.ddp_dnvp_relation += 1;
    }

    if (Q.labor_minister_party == "LVP") {
        Q.lvp_bourgeois_strength += 3;

        Q.lvp_labor_strength -= 3;

        Q.lvp_bourgeois_dissent -= 3;
        Q.lvp_nationalist_dissent -= 3;
        
        Q.lvp_labor_dissent += 3;

        Q.workers_lvp -= 2;

        Q.ddp_kpd_relation -= 4;
        Q.ddp_z_relation += 3;
        Q.ddp_dvp_relation += 3;
        Q.ddp_dnvp_relation += 3;
    } else if (Q.ddp_in_government && Q.lvp_formed) {
        Q.lvp_bourgeois_strength += 1;

        Q.lvp_labor_strength -= 1;

        Q.lvp_bourgeois_dissent -= 1;
        Q.lvp_nationalist_dissent -= 1;

        Q.lvp_labor_dissent += 1;

        Q.workers_lvp -= 1;

        Q.ddp_kpd_relation -= 2;
        Q.ddp_z_relation += 1;
        Q.ddp_dvp_relation += 1;
        Q.ddp_dnvp_relation += 1;
    }
    
    if (Q.labor_minister_party == Q.z_party_name) {
        Q.z_conservative_strength += 3;

        Q.z_left_strength -= 3;

        Q.z_conservative_dissent -= 3;

        Q.z_labor_dissent += 3;
        Q.z_left_dissent += 3;

        Q.workers_z -= 3;

        Q.z_kpd_relation += 2;
        Q.z_dvp_relation += 1;
        Q.ddp_z_relation += 1;
        Q.z_dnvp_relation += 1;
    } else if (Q.z_in_government) {
        Q.z_conservative_strength += 1;

        Q.z_left_strength -= 1;

        Q.z_conservative_dissent -= 1;

        Q.z_labor_dissent += 1;
        Q.z_left_dissent += 1;

        Q.workers_z -= 1;
    }

    if (Q.labor_minister_party == "DVP") {
        Q.dvp_bourgeois_strength += 2;

        Q.dvp_labor_strength -= 2;

        Q.dvp_bourgeois_dissent -= 2;
        Q.dvp_nationalist_dissent -= 2;
        
        Q.dvp_labor_dissent += 2;

        Q.workers_dvp -= 1;

        Q.dvp_z_relation += 3;
        Q.dvp_dvp_relation += 3;
        Q.dvp_dnvp_relation += 3;
    } else if (Q.dvp_in_government && !Q.lvp_formed) {
        Q.dvp_bourgeois_strength += 1;

        Q.dvp_labor_strength -= 1;

        Q.dvp_bourgeois_dissent -= 1;
        Q.dvp_nationalist_dissent -= 1;
        
        Q.dvp_labor_dissent += 1;

        Q.dvp_z_relation += 1;
        Q.dvp_dvp_relation += 1;
        Q.dvp_dnvp_relation += 1;
    }

    if (Q.labor_minister_party == "KVP") {
        Q.kvp_volkskonservativ_strength += 2;

        Q.kvp_christian_social_strength -= 2;

        Q.kvp_volkskonservativ_dissent -= 2;
        Q.kvp_nationalist_dissent -= 2;
        
        Q.kvp_christian_social_dissent -= 2;

        Q.workers_kvp -= 1;

        Q.ddp_kvp_relation += 1;
        Q.dvp_kvp_relation += 1;
        Q.z_kvp_relation += 1;
        Q.kvp_dnvp_relation += 1;
    } else if (Q.kvp_in_government) {
       Q.kvp_volkskonservativ_strength += 1;

        Q.kvp_christian_social_strength -= 1;

        Q.kvp_volkskonservativ_dissent -= 1;
        Q.kvp_nationalist_dissent -= 1;
        
        Q.kvp_christian_social_dissent -= 1;
    }

    if (Q.labor_minister_party == "DNVP") {
        Q.dnvp_volkskonservativ_strength -= 2;

        Q.dnvp_authoritarian_strength += 2;

        Q.dnvp_volkskonservativ_dissent -= 3
        Q.dnvp_agrarian_dissent -= 3;
        Q.dnvp_authoritarian_dissent -= 3;
        
        Q.dnvp_authoritarian_dissent += 2;

        Q.workers_dnvp -= 1;

        Q.ddp_dnvp_relation += 1;
        Q.dvp_dnvp_relation += 1;
        Q.z_dnvp_relation += 1;
        Q.kvp_dnvp_relation += 1;
    } else if (Q.kvp_in_government) {
       Q.kvp_volkskonservativ_strength += 1;

        Q.kvp_christian_social_strength -= 1;

        Q.kvp_volkskonservativ_dissent -= 1;
        
        Q.kvp_christian_social_dissent -= 1;
    }

    if (Q.labor_minister_party == "DNF") {
        Q.dnf_authoritarian_strength += 4;

        Q.dnf_paramilitary_strength -= 4;

        Q.dnf_authoritarian_dissent -= 4;
        Q.dnf_nationalist_dissent -= 4;
    } else if (Q.dnf_in_government) {
        Q.dnf_authoritarian_strength += 2;

        Q.dnf_paramilitary_strength -= 2;

        Q.dnf_authoritarian_dissent -= 2;
        Q.dnf_nationalist_dissent -= 2;
    }


    if (capital_strike_progress > 1) {
        capital_strike_progress -= 1
    }

    if (capital_strike_progress > 8) {
        capital_strike_progress -= 1
    }

    if (coalition_dissent > 0 && (Q.z_in_government && Q.labor_minister_party != Q.z_party_name) || Q.dvp_in_government || Q.dnvp_in_government || Q.bvp_in_government || Q.kvp_in_government || Q.ddp_in_government) {
        Q.coalition_dissent -= 1;
    }

    pro_labor -= 1;
    strike_term_seen += 1;
    dvp_left += 1;
    ddp_right += 1;
    ddp_cohesion -= 0.5;
    lvp_left += 1;
!}     

The more radical workers despise [? if labor_minister_party == "SPD": our ?][? if labor_minister_party != "SPD": the ?] suppression of their strikes [? if labor_minister_party == "SPD": , recalling the days of Friedrich Ebert. ?]

@balance
subtitle: Both sides need to share the pain in the current crisis.
on-arrival: {!
    labor_affairs_seen = 1;

    
    if (Q.kpd_in_government) {
        Q.kpd_weddinger_dissent += 7;
        Q.kpd_stalinist_dissent += 6;
        Q.kpd_conciliator_dissent += 5;
        Q.kpd_brandlerite_dissent += 4;

        Q.workers_kpd -= 1;

        kpd_coalition_dissent += 1;
    }

    if (Q.labor_minister_party == "SPD") {l
        Q.labor_dissent += 4;
        
        Q.workers_spd -= 2;

        Q.kpd_relation -= 5;

        Q.labor_goal_spd_peoples += 1;
    } if (Q.spd_in_government) {
         Q.labor_dissent += 2;
        
        Q.workers_spd -= 1;

        Q.kpd_relation -= 3;
    }

    if (Q.labor_minister_party == Q.ddp_name) {
        Q.ddp_liberal_strength += 2;
        
        Q.ddp_liberal_dissent -= 2;

        Q.ddp_labor_dissent += 1;
        Q.ddp_business_dissent += 1;

        Q.ddp_z_relation += 2;
        Q.ddp_dvp_relation += 2;
        Q.ddp_kvp_relation += 2;

        Q.ddp_kpd_relation -= 2;
        
        if (Q.dnf_formed) {
            Q.ddp_dnvp_relation -= 2;
        }
    } else if (Q.ddp_in_government && !Q.lvp_formed) {
        Q.ddp_liberal_strength += 1;
        
        Q.ddp_liberal_dissent -= 1;

        Q.ddp_z_relation += 1;
        Q.ddp_dvp_relation += 1;
        Q.ddp_kvp_relation += 1;

        Q.ddp_kpd_relation -= 1;

        if (Q.dnf_formed) {
            Q.ddp_dnvp_relation -= 1;
        }
    }

    if (Q.labor_minister_party == "LVP") {
        Q.lvp_liberal_strength += 3;
        
        Q.lvp_liberal_dissent -= 3;

        Q.lvp_labor_dissent += 1;
        Q.lvp_bourgeois_dissent += 1;
        Q.lvp_nationalist_dissent += 1;

        Q.lvp_z_relation += 3;
