title: KPD Media
new-page: true

@media
title: Media
view-if: {!
    if (Q.kpd_rally_timer <= 0) {
        return false;
    } else if (Q.labor_minister_party == Q.kpd_name && Q.labor_affairs_post_timer == 0 && Q.strike_term_seen_post_timer == 0) {
        return false;
    } else if (Q.kpd_media_timer > 0) {
        return false;
    } else {
        return true;
    }
!}

The KPD will set the direction of their newspaper and radio

- @mobilize
- @campaign
- @ideological_stalinist
- @ideological_conciliator
- @ideological_brandlerite
- @radio
- @radio_2
- @radio_3
- @radio_4

@mobilize
title: Die Rote Fahne will mobilize the public against fascism, capitalism, and monarchism
view-if: {!
    if (Q.kpd_leader == "Thälmann") {
        if (Q.kpd_stalinist_strength < 80) {
            return false;
        } else if (!Q.return_to_normalcy && Q.anticommunist_force >= 30 && Q.year >= 1930) {
            return true;
        } else {
            return false;
        }
    } else if (Q.kpd_leader == "Conciliators") {
        if (Q.kpd_conciliator_strength < 70) {
            return false;
        } else if (!Q.return_to_normalcy && Q.rfb_force < Q.noncommunist_force && Q.year >= 1930) {
            return true;
        } else {
            return false;
        }
    } else if (Q.kpd_leader == "Brandlerites") {
        if (Q.kpd_stalinist_strength < 60) {
            return false;
        } else if (!Q.return_to_normalcy && Q.left_force < Q.anticommunist_force && Q.year >= 1930) {
            return true;
        } else {
            return false;
        }
    } else {
        return false;
    }
!}

Die Rote Fahne coordinates with the KPD and RFB to organize protests, rallies, and strikes

