title: DDP Media
new-page: true

# Ripped from Cascadian Ptriot's amazing DDP mod

@media
title: Media
view-if: {!
    if (Q.ddp_rally_post_timer > 0) {
        return false;
    } else if (Q.labor_minister_party == Q.ddp_name && Q.labor_affairs_post_timer == 0 && Q.strike_term_seen_post_timer == 0) {
        return false;
    } else if (Q.ddp_enemies_post_timer > 0) {
        return false;
    } else if (Q.ddp_media_post_timer > 0) {
        return true;
    } else {
        return false;
    }
!}

